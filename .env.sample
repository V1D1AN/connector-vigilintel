OPENCTI_URL=http://opencti:8080
OPENCTI_TOKEN=your-token-here
CONNECTOR_ID=vigilintel
CONNECTOR_LOG_LEVEL=info
# Format: "stix" (full STIX bundles) or "json" (parsed JSON with all sections)
VIGILINTEL_FORMAT=stix
VIGILINTEL_LANGUAGE=en
VIGILINTEL_INTERVAL=86400
VIGILINTEL_DAYS_TO_IMPORT=1
# Default TLP applied to all objects (CLEAR/GREEN/AMBER/AMBER+STRICT/RED, or empty to disable)
VIGILINTEL_DEFAULT_MARKING=TLP:AMBER
# JSON options (all sections enabled by default):
VIGILINTEL_IMPORT_THREAT_ACTORS=true
VIGILINTEL_IMPORT_VULNERABILITIES=true
VIGILINTEL_IMPORT_INCIDENTS=true
VIGILINTEL_IMPORT_ARTICLES=true
VIGILINTEL_IMPORT_GEOPOLITICAL=true
VIGILINTEL_IMPORT_ANALYSIS=true
VIGILINTEL_CREATE_INDICATORS=true
